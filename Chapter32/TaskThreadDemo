public class TaskTheadDemo {
    public static void main(String[] args) {
        // Create a task thread
        Runnable printA = new PrintChar('a', 100);
        Runnable printB = new PrintChar('b', 100);
        Runnable print100= new PrintNum(100);

        // Create threads
        Thread thread1 = new Thread(printA);
        Thread thread2 = new Thread(printB);
        Thread thread3 = new Thread(print100);

        // Start threads
        thread1.start();
        thread2.start();
        thread3.start();
    }

    }

    // The task for printing a character a specified number of times
    class PrintChar implements Runnable {
        private char charToPrint; // The character to print
        private int times; // The times to repeat

        /** Construct a task with specified character and number of times to print the character */
        public PrintChar(char c, int t) {
            charToPrint = c;
            times = t;
        }

        @Override /** Override the run() method to tell the system what the thread will do */
        public void run() {
            for (int i = 0; i < times; i++) {
                System.out.print(charToPrint);
            }
        }

    }
    // The task for printing numbers from 1 to n for a specified n
    class PrintNum implements Runnable {
        private int lastNum;

        /** Construct a task for printing 1, 2, ... to n */
        public PrintNum(int n) {
            lastNum = n;
        }
        @Override /** Override the run() method to tell the system what the thread will do */
        public void run() { 
            for (int i = 1; i<= lastNum; i++) {
                System.out.print(" " + i);
            }
        }
    }

