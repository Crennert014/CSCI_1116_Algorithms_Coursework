import javafx.application.Application;
import javafx.application.Platform;


import java.io.DataInputStream;
import java.io.DataOutputStream;
import java.net.Socket;

import javafx.scene.Scene;
import javafx.scene.input.KeyCode;
import javafx.scene.input.KeyEvent;
import javafx.scene.control.Label;
import javafx.scene.control.ScrollPane;
import javafx.scene.control.TextArea;
import javafx.scene.layout.BorderPane;
import javafx.scene.layout.VBox;
import javafx.stage.Stage;

public class Exercise33_09Client extends Application {
  private TextArea taServer = new TextArea();
  private TextArea taClient = new TextArea();
  private DataOutputStream toServer = null;
  private DataInputStream fromServer = null;
 
  @Override // Override the start method in the Application class
  public void start(Stage primaryStage) {
    taServer.setEditable(false);
    taServer.setWrapText(true);
    taClient.setWrapText(true);

    BorderPane pane1 = new BorderPane();
    pane1.setTop(new Label("History"));
    pane1.setCenter(new ScrollPane(taServer));
    BorderPane pane2 = new BorderPane();
    pane2.setTop(new Label("New Message"));
    pane2.setCenter(new ScrollPane(taClient));
    
    VBox vBox = new VBox(5);
    vBox.getChildren().addAll(pane1, pane2);

    // Create a scene and place it in the stage
    Scene scene = new Scene(vBox, 200, 200);
    primaryStage.setTitle("Exercise31_09Client"); // Set the stage title
    primaryStage.setScene(scene); // Place the scene in the stage
    primaryStage.show(); // Display the stage

    taClient.addEventFilter(KeyEvent.KEY_PRESSED, event -> {
      if (event.getCode() == KeyCode.ENTER) {
        event.consume();

        String message = taClient.getText().trim();
        if (message.isEmpty()) {
          taClient.clear();
          return;
        }

        if (toServer == null) {
          taServer.appendText("Not connected to server yet.\n");
          return;
        }

        try {
          toServer.writeUTF(message);
          toServer.flush();
          taServer.appendText("Client: " + message + "\n");
          taClient.clear();
        } catch (Exception ex) {
          taServer.appendText("Send error: " + ex.getMessage() + "\n");
        }
      }
    });

    new Thread(() -> {
      try {
        Socket socket = new Socket("localhost", 8000);
        toServer = new DataOutputStream(socket.getOutputStream());
        fromServer = new DataInputStream(socket.getInputStream());

        Platform.runLater(() -> taServer.appendText("Connected\n"));

        while (true) {
          String response = fromServer.readUTF().trim();
          if (!response.isEmpty()) {
            Platform.runLater(() -> taServer.appendText("Server: " + response + "\n"));
          }
        }
      } catch (Exception ex) {
        Platform.runLater(() -> taServer.appendText("Connection error: " + ex.getMessage() + "\n"));
      }
    }).start();
  }


    
  

  /**
   * The main method is only needed for the IDE with limited
   * JavaFX support. Not needed for running from the command line.
   */
  public static void main(String[] args) {
    launch(args);
  }
}
